# monsmain v1 — environment
# Password for the first login to the dashboard. Change it in Settings afterwards.
INITIAL_PASSWORD=change-me

# Secret used to sign dashboard sessions. Set a long random value and keep it stable.
JWT_SECRET=change-me-to-a-long-random-secret

# Where the SQLite database, backups and logs live. Defaults to %APPDATA%\monsmain (Windows)
# or ~/.monsmain (Linux / macOS) when unset.
DATA_DIR=C:/monsmain-data

# Port served by the dashboard and the OpenAI-compatible endpoint.
PORT=20127

# Public URL, used for links and callbacks behind a reverse proxy.
BASE_URL=http://localhost:20127
NEXT_PUBLIC_BASE_URL=http://localhost:20127

# Keep false when serving over plain HTTP on localhost.
AUTH_COOKIE_SECURE=false

# Set true to require a key on every /v1 request.
REQUIRE_API_KEY=false
